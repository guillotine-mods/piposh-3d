# Godot 4
.godot/
*.translation

# `export_presets.cfg` is tracked deliberately. The Director player embeds this
# project by mounting a `.pck` built from it, and the pack is built by
# `--export-pack Pack`, so the preset that names it has to travel with the repo.
# Keystores and signing material are ignored separately below.

# Local Android / APK output (reinstall template via Editor if needed)
build/
android/
*.apk
*.aab

# Large original dump (keep local; re-extract from zip if needed)
original/
assets/original/

# Python
__pycache__/
*.pyc
.venv/

# tools/wmb_web_viewer.py's own on-demand brush/model .glb cache -- dev-tool
# scratch output only, regenerable from original/ via extract_wmb_mesh.py /
# convert_mdl.py, deliberately NOT part of the "zero-py-no-assets" shipped
# game (which parses WMB/MDL directly at runtime instead).
tools/.web_cache/

# Editor / OS
.cursor/
*.swp
Thumbs.db
.DS_Store
